# Default provider: OpenRouter JEV.
OPENROUTER_API_KEY=

# TypeSafe's own JEV API, with provider type "typesafe".
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional overrides, useful in CI without editing playwright-jev.config.ts.
# PLAYWRIGHT_JEV_URL=https://decisions.internal.example/api/decide
# PLAYWRIGHT_JEV_MODEL=typesafe/jev-1.13
# PLAYWRIGHT_JEV_API_KEY_ENV=MY_DECISIONS_KEY
# PLAYWRIGHT_JEV_CONFIG=path/to/playwright-jev.config.ts
# PLAYWRIGHT_JEV_DISABLED=1
